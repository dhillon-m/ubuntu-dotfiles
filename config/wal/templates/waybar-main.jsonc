{
  "output": "DP-3",
  "layer": "top",
  "height": 33,
  "spacing": 4,
  "margin-top": 5,
  "margin-left": 5,
  "margin-right": 5,
  "modules-left": ["custom/windows","sway/workspaces","sway/window","tray","sway/mode"],
  "modules-center": ["clock"],
  "modules-right": ["custom/cpu","custom/gpu","custom/memory","disk","custom/network","custom/vpn","pulseaudio","custom/battery"],

  "custom/windows": {
    "format": "<span ></span>",
    "on-click": "~/.config/waybar/main/scripts/windows-menu.sh",
    "tooltip": false
  },
  "sway/workspaces": {
    "disable-scroll": true,
    "active-only": false,
    "all-outputs": false,
    "warp-on-scroll": false,
    "format": "{{icon}}",
    "format-icons": {
      "1": "<span>☿</span>", "2": "<span>♀</span>", "3": "<span>♁</span>",
      "4": "<span>☾</span>", "5": "<span>♂</span>", "6": "<span>♃</span>",
      "7": "<span>♄</span>", "8": "<span>♅</span>", "9": "<span>♆</span>",
      "10": "<span>♇</span>"
    },
    "persistent-workspaces": {
      "1": ["DP-3"], "3": ["DP-3"], "5": ["DP-3"], "7": ["DP-3"], "9": ["DP-3"]
    }
  },
  "sway/window": {
    "format": "<span color='{background}' bgcolor='{color5}' > 󰣆 </span> {{app_id}}",
    "separate-outputs": true,
    "tooltip": false
  },
  "sway/mode": {{ "format": " {{}}", "max-length": 50, "tooltip": false }},
  "tray": {{ "icon-size": 14, "spacing": 8 }},
  "disk": {{
    "format": "<span color='{background}' bgcolor='{color1}' >  </span> {{free}}",
    "interval": 20, "tooltip": false
  }},
  "custom/cpu": {{
    "exec": "~/.config/waybar/main/scripts/cpu.sh",
    "return-type": "json", "interval": 2, "format": "{{}}", "tooltip": false,
    "on-click": "~/.config/waybar/main/scripts/cpu-btop.sh"
  }},
  "custom/gpu": {{
    "exec": "~/.config/waybar/main/scripts/gpu.sh",
    "return-type": "json", "interval": 2, "format": "{{}}", "tooltip": false,
    "on-click": "~/.config/waybar/main/scripts/gpu-btop.sh"
  }},
  "custom/memory": {{
    "exec": "~/.config/waybar/main/scripts/memory.sh",
    "interval": 2, "return-type": "json",
    "format": "<span color='{background}' bgcolor='{color6}' >  </span> {{}}",
    "on-click": "~/.config/waybar/main/scripts/mem-btop.sh"
  }},
  "pulseaudio": {{
    "format": "<span color='{background}' bgcolor='{color4}' >  </span> {{volume}}%",
    "format-muted": "<span color='{background}' bgcolor='{color1}' >  </span> {{volume}}%",
    "format-bluetooth": "<span color='{background}' bgcolor='{color4}' > 󰂰 </span> {{volume}}%",
    "format-bluetooth-muted": "<span color='{background}' bgcolor='{color1}' > 󰂲 </span> {{volume}}%",
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-click-right": "~/.config/waybar/main/scripts/pavucontrol.sh",
    "tooltip": false, "max-volume": 130
  }},
  "custom/battery": {{
    "exec": "~/.config/waybar/main/scripts/battery.sh",
    "return-type": "json", "interval": 5, "format": "{{}}", "tooltip": false
  }},
  "custom/network": {{
    "exec": "~/.config/waybar/main/scripts/network.sh",
    "return-type": "json", "interval": 2, "format": "{{}}", "tooltip": false,
    "on-click": "~/.config/waybar/main/scripts/network-toggle.sh",
    "on-click-right": "~/.config/waybar/main/scripts/network-menu.sh"
  }},
  "custom/vpn": {{
    "exec": "~/.config/waybar/main/scripts/vpn.sh",
    "return-type": "json", "interval": 2, "signal": 4, "format": "{{}}", "tooltip": false,
    "on-click": "~/.config/waybar/main/scripts/vpn-toggle.sh",
    "on-click-right": "~/.config/waybar/main/scripts/vpn-menu.sh"
  }},
  "clock": {{
    "format": "<span color='{background}' bgcolor='{color4}' >  </span> {{:%a %d | %H:%M}}",
    "tooltip": false, "interval": 1
  }}
}
